  [2489 :block/title "Directions"]
  [2489 :block/updated-at 1785697471983]
  [2489 :block/uuid #uuid "6a6f94bf-b1df-4dcd-8016-38c03b3c6df1"]
  [2489 :logseq.property/heading 2]
